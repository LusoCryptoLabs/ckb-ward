{
  "name": "ckb-ward",
  "version": "0.2.0",
  "description": "Ward, lock proof for CKB: prove control of any CKB lock by running the lock on a transaction that can never land",
  "license": "MIT",
  "author": "LusoCryptoLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LusoCryptoLabs/ckb-ward.git"
  },
  "homepage": "https://github.com/LusoCryptoLabs/ckb-ward#readme",
  "bugs": {
    "url": "https://github.com/LusoCryptoLabs/ckb-ward/issues"
  },
  "keywords": [
    "ckb",
    "nervos",
    "lock",
    "proof",
    "signature",
    "wallet",
    "bip-322",
    "eip-1271"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "default": "./dist/wallet.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@ckb-ccc/core": "~1.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
